# Aplicación
COMPOSE_PROJECT_NAME=amvarmar_lms
APP_NAME=AMVARMAR LMS
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL
POSTGRES_DB=amvarmar_lms
POSTGRES_USER=amvarmar
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_secure_password
REDIS_DB=0

# Autenticación JWT
JWT_ACCESS_SECRET_KEY=replace_with_secure_random_key
JWT_REFRESH_SECRET_KEY=replace_with_different_secure_random_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies de autenticación
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1