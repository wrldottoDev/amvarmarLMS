# AMVARMAR LMS — variables de entorno del backend
# Copiar a .env y completar. .env NUNCA se versiona (ver .gitignore).

ENVIRONMENT=local
DEBUG=true

# postgresql+asyncpg://usuario:password@host:puerto/basededatos
DATABASE_URL=postgresql+asyncpg://amvarmar:CAMBIAR_ESTE_VALOR@localhost:5434/amvarmar_lms
REDIS_URL=redis://localhost:6380/0

# Tres claves independientes (Paso 1.6) — nunca reutilizar una para otro propósito.
# Generar cada una con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=CAMBIAR_ESTE_VALOR
REFRESH_FINGERPRINT_KEY=CAMBIAR_ESTE_VALOR
FCM_TOKEN_ENCRYPTION_KEY=CAMBIAR_ESTE_VALOR

# --- Usadas por infra/docker/docker-compose.yml, no por Settings() todavía ---
POSTGRES_DB=amvarmar_lms
POSTGRES_USER=amvarmar
POSTGRES_PASSWORD=CAMBIAR_ESTE_VALOR
MINIO_ROOT_USER=amvarmar
MINIO_ROOT_PASSWORD=CAMBIAR_ESTE_VALOR

# --- Asistente virtual (ADR-0012) — no implementado todavía ---
COPILOT_NAME=AMVI
COPILOT_MODEL=gpt-5.6-luna
COPILOT_TEMPERATURE=0.2
# Secreto real: va en .env, NUNCA aquí con su valor.
OPENAI_API_KEY=CAMBIAR_ESTE_VALOR
