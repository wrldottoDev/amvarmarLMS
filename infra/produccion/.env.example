# AMVARMAR LMS — variables de producción (piloto incluido).
# Copiar a `.env` EN LA VPS, completar y dejarlo con permisos 600.
# Nunca se versiona ni se copia a otra máquina. Cada secreto se genera nuevo
# para este entorno: ninguno se reutiliza del desarrollo local.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=production
DEBUG=false
VERSION=piloto

# --- Base de datos y almacenamiento (los usa el compose) ---
POSTGRES_DB=amvarmar_lms
POSTGRES_USER=amvarmar
POSTGRES_PASSWORD=
# Garage (storage). Lo generan ../garage/generar_claves.sh junto con las
# claves S3 de abajo; no se escriben a mano.
GARAGE_RPC_SECRET=

# --- Claves de la aplicación: tres distintas, nunca reutilizar ---
JWT_SIGNING_KEY=
REFRESH_FINGERPRINT_KEY=
FCM_TOKEN_ENCRYPTION_KEY=

# --- Storage (Garage) ---
# Pública: el navegador sube y descarga contra esta dirección con URLs
# firmadas; nginx publica el bucket en /amvarmar-documentos/ del mismo
# dominio. El backend también la usa (vuelve por el nginx local).
S3_ENDPOINT_URL=https://app.amvarmar.com
# Formato de Garage: GK + 24 hex y 64 hex. Las genera generar_claves.sh.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=amvarmar-documentos
S3_REGION=us-east-1
# Clave de solo lectura para ../backup/respaldar_archivos.sh.
RESPALDO_S3_ACCESS_KEY=
RESPALDO_S3_SECRET_KEY=

# --- URL pública del sistema (enlaces de los correos) ---
# Piloto: https://app.amvarmar.com:8443 (nginx/piloto-lms-8443.conf).
FRONTEND_BASE_URL=https://app.amvarmar.com
# Host de S3_ENDPOINT_URL: los contenedores lo resuelven a la VPS.
DOMINIO_PUBLICO=app.amvarmar.com

# --- Correo ---
# Piloto: Mailpit (perfil `piloto`). Nada sale hacia clientes.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=AMVARMAR <pricing1@amvarmar.com>
# Cutover: SMTP_HOST=mail.amvarmar.com, SMTP_PORT=465, SMTP_USE_SSL=true,
# SMTP_USERNAME/SMTP_PASSWORD de la cuenta real.

# --- Asistente AMVI ---
# Clave propia de producción, distinta de la de desarrollo.
OPENAI_API_KEY=
COPILOT_MODEL=gpt-5.6-luna

# --- Métricas (Prometheus) ---
METRICS_TOKEN=

# --- Puertos del host (solo 127.0.0.1); cambiar si alguno está tomado ---
PUERTO_BACKEND=58000
PUERTO_FRONTEND=53000
PUERTO_STORAGE=59010
PUERTO_POSTGRES=55432
PUERTO_MAILPIT=58025
